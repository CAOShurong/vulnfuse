{
  "name": "vulnfuse",
  "version": "0.4.23",
  "description": "Merge and explain duplicate findings across vulnerability scanners",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "vulnfuse": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/sync-package-license.mjs",
    "build": "node ../../scripts/clean-workspace-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/make-cli-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@vulnfuse/core": "0.4.23",
    "commander": "15.0.0",
    "tinyglobby": "0.2.17"
  }
}

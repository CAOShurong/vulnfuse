  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Relative Path Scanner",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "CVE-2025-43210",
              "shortDescription": { "text": "Synthetic URI-base correlation case" },

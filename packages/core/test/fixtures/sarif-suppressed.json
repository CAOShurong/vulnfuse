{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Suppression Fixture",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "CVE-2024-9001",
              "shortDescription": { "text": "Suppressed fixture finding one" },
              "properties": {
                "security-severity": "8.0",
                "tags": ["security", "dependency"]
              }
            },
            {
              "id": "CVE-2024-9002",
              "shortDescription": { "text": "Suppressed fixture finding two" },
              "properties": {
                "security-severity": "8.0",
                "tags": ["security", "dependency"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-9001",
          "level": "error",
          "message": { "text": "Suppressed by a source annotation" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/one.ts" },
                "region": { "startLine": 7 }
              }
            }
          ],
          "suppressions": [
            {
              "kind": "inSource",
              "justification": "Reviewed <script>alert('not markup')</script>"
            }
          ]
        },
        {
          "ruleId": "CVE-2024-9002",
          "level": "error",
          "message": { "text": "Suppressed in an external review store" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/two.ts" },
                "region": { "startLine": 11 }
              }
            }
          ],
          "suppressions": [
            {
              "kind": "external",
              "status": "accepted",
              "justification": "Risk accepted for the fixture"
            }
          ]
        }
      ]
    }
  ]
}

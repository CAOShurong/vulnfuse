{
  "name": "@vulnfuse/core",
  "version": "0.4.24",
  "description": "Canonical vulnerability model, report parsers, and explainable correlation engine",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-package-license.mjs",
    "build": "node ../../scripts/clean-workspace-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rgrove/parse-xml": "4.2.3",
    "packageurl-js": "2.0.1",
    "papaparse": "5.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2"
  }
}
